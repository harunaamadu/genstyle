generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CARD
  MOMO
  COD
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

/* ---------- Auth.js ---------- */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/* ---------- Shop ---------- */

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email      String
  firstName  String
  lastName   String
  phone      String
  address1   String
  address2   String @default("")
  city       String
  region     String
  postalCode String @default("")
  country    String

  paymentMethod PaymentMethod
  paymentDetail String?
  promoCode     String?

  // Money in cents (USD)
  subtotal     Int
  discount     Int
  shippingCost Int
  total        Int

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Snapshot of the product at purchase time (the catalogue lives in the CMS)
  productId String
  slug      String
  sku       String
  name      String
  image     String
  color     String
  size      String
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  topic       String
  orderNumber String?
  message     String   @db.Text
  userId      String?
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
}